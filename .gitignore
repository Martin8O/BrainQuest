# ── Private working area — LOCAL ONLY, never synced to GitHub ──────────────
# Claude's durable memory + working notes live here (NOT in ~/.claude or C:\).
local/

# ── Internal dev scaffolding — kept local, NOT published (public repo hygiene) ──
# Changelog, teaching protocol, and Claude Code config are dev-process files, not product.
/dev_history.md
/LEARNING_PROTOCOL.md
/.claude/

# ── Runtime app state — personal learning progress, gitignored (never shipped) ──
# The app writes review/variation state here per-device; data/.gitkeep preserves the dir.
/data/*.json

# ── Personal Claude Code settings (machine paths; enforced guardrails) ──────
.claude/settings.local.json

# ── Dependencies ───────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*

# ── Next.js / build output ─────────────────────────────────────────────────
/.next/
/out/
/build
dist/
*.tsbuildinfo
next-env.d.ts

# ── Capacitor native shell (M3) — generated per-machine via `npx cap add android` ──
# The android/ project is regenerated from capacitor.config.ts + the web build, like node_modules.
# Signing keys are SECRETS — never commit a keystore.
/android/
/ios/
*.keystore
*.jks

# ── Testing ────────────────────────────────────────────────────────────────
/coverage

# ── Generated client-app data (M2: built by `npm run app:data`, not committed) ──
/public/pack.json
/public/app-config.json
/public/reviews.seed.json

# ── Python (any local tooling/probes) ──────────────────────────────────────
.venv/
__pycache__/
*.pyc

# ── Env / secrets ──────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Retired one-off verify/debug scripts (kept local, never synced) ─────────
scripts/

# ── Deploy / misc ──────────────────────────────────────────────────────────
.vercel
.DS_Store
Thumbs.db
*.pem
npm-debug.log*
